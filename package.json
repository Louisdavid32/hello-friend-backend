{
  "name": "hello-friend-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Control plane, realtime chat and SFU integration for Hello Friend.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run docs:check && npm run test:coverage && npm run build",
    "clean": "rimraf coverage dist",
    "dev:api": "tsx watch src/apps/api/bootstrap.ts",
    "dev:realtime": "tsx watch src/apps/realtime/bootstrap.ts",
    "dev:worker": "tsx watch src/apps/worker/bootstrap.ts",
    "migrate": "tsx src/apps/migration/bootstrap.ts",
    "docs:check": "typedoc --emit none",
    "docs:code": "typedoc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start:api": "node dist/apps/api/bootstrap.js",
    "start:realtime": "node dist/apps/realtime/bootstrap.js",
    "start:worker": "node dist/apps/worker/bootstrap.js",
    "start:migration": "node dist/apps/migration/bootstrap.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration/infrastructure.integration.test.ts",
    "test:integration:chat": "vitest run tests/integration/chat-postgres.integration.test.ts",
    "test:integration:redis": "vitest run tests/integration/realtime-redis.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/proxy-addr": "5.1.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/platform-ws": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/websockets": "12.0.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prometheus-io/client": "0.16.1",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
