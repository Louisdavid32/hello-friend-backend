NODE_ENV=development
APP_ROLE=api
APP_VERSION=0.1.0-dev
REGION=local

HTTP_HOST=127.0.0.1
HTTP_PORT=3000
PUBLIC_APP_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
PUBLIC_REALTIME_URL=ws://localhost:3001/v1/realtime
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=

HTTP_MAX_BODY_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
SHUTDOWN_GRACE_MS=15000
HEALTH_CHECK_TIMEOUT_MS=1000

# Enabled by default only in development and test.
OPENAPI_ENABLED=true
OPENAPI_PATH=/docs
OPENAPI_JSON_PATH=/openapi.json

# Local dependencies are opt-in. Production requires file-mounted secrets, TLS,
# PostgreSQL, and Redis Cluster; inline DSNs are rejected there.
SECRET_MOUNT_ROOT=/run/secrets
DATABASE_ENABLED=false
DATABASE_URL=postgresql://hello_friend_owner:hello_friend_local_only@127.0.0.1:5432/hello_friend
DATABASE_URL_FILE=
DATABASE_DIRECT_URL=postgresql://hello_friend_owner:hello_friend_local_only@127.0.0.1:5432/hello_friend
DATABASE_DIRECT_URL_FILE=
DATABASE_SSL_CA_FILE=
DATABASE_TLS_REQUIRED=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=9000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_TX_TIMEOUT_MS=10000
DATABASE_APPLICATION_NAME=
MIGRATION_LOCK_ID=1934622993

REDIS_ENABLED=false
REDIS_MODE=standalone
REDIS_URLS=redis://127.0.0.1:6379/0
REDIS_URL_FILE=
REDIS_SSL_CA_FILE=
REDIS_TLS_REQUIRED=false
REDIS_CLIENT_NAME=
REDIS_KEY_PREFIX=hf:v1
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_MAX_RECONNECT_DELAY_MS=5000

OUTBOX_BATCH_SIZE=50
OUTBOX_CONCURRENCY=10
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_BASE_RETRY_MS=1000
OUTBOX_MAX_RETRY_MS=300000
OUTBOX_POLL_INTERVAL_MS=500

# Versioned JSON: {"currentVersion":1,"keys":{"1":"<base64url-32-bytes>"}}
MEETINGS_ENABLED=false
CAPABILITY_HMAC_KEYRING=
CAPABILITY_HMAC_KEYRING_FILE=
SESSION_HMAC_KEYRING=
SESSION_HMAC_KEYRING_FILE=
MEETING_CAPABILITY_TTL_SECONDS=86400
MEETING_TTL_SECONDS=86400
SESSION_IDLE_TTL_SECONDS=3600
SESSION_ABSOLUTE_TTL_SECONDS=21600
SESSION_COOKIE_NAME=hf_session
MEETING_CREATE_RATE_LIMIT=20
MEETING_JOIN_RATE_LIMIT=60
MEETING_RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
